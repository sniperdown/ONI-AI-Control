<Project Sdk="Microsoft.NET.Sdk">
  <!-- ReqJournal.cs 的独立单测（不进 mod 构建）：
       把 mod 里的 ReqJournal.cs 原文链进来，只用一个 Snap.Str 桩顶掉游戏侧依赖。
       跑法：在这个目录里 `dotnet run`（或 dotnet run -p 本 csproj）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ReqJournalTest</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\OniAiBridge\ReqJournal.cs" />
  </ItemGroup>
</Project>